MEMORY_DB_PATH=data/memory.db
SHORT_TERM_WINDOW=10

# Embeddings: sentence-transformers (default) or hashed (offline tests only).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# Only used by the hashed backend.
EMBEDDING_DIM=256

# Retrieval: rrf fuses dense and BM25 rankings; dense and lexical exist for ablations.
RETRIEVAL_MODE=rrf
# The hybrid LoCoMo measured: the top 10 memories plus the top 5 raw turns. TURN_TOP_K=0 returns memories alone.
RETRIEVAL_TOP_K=10
TURN_TOP_K=5
# Optional cosine floor below which a memory is never injected; empty means off.
RETRIEVAL_MIN_SIMILARITY=
LEXICAL_TOP_K=20
SEMANTIC_TOP_K=20
RRF_K=60
USE_RECENCY=false

# Extraction: regex (offline, narrow) or llm (structured extraction over any OpenAI-compatible API).
MEMORY_EXTRACTOR=regex
# Gemini is shown. Ollama: http://localhost:11434/v1  vLLM: http://localhost:8000/v1  OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# On the Gemini free tier, gemini-3.5-flash allows 20 requests a day; the lite model is the practical default.
LLM_MODEL=gemini-3.5-flash-lite
# Every request and reply is cached here, so reruns are free and interrupted runs resume.
LLM_CACHE_PATH=data/llm_cache.sqlite
LLM_REQUESTS_PER_MINUTE=10
# Sent as reasoning_effort when set. Use none for the distilled student under Ollama
# (LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=neurohack-extractor), which was trained without thinking.
LLM_REASONING_EFFORT=
# Ask the server to constrain output to the JSON schema. Ollama's constrained decoding puts keys in alphabetical
# order, not the order the distilled student learned, so the comparison in RESULTS.md also runs it with this off.
LLM_STRUCTURED_OUTPUT=true
# Let the LLM write replies in the live API; otherwise a small rule-based responder is used.
ENABLE_LLM_RESPONSE=false
